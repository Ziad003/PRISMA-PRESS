model User{
    id String @id @default(uuid())
    name String @db.VarChar(20)
    email String @unique
    passWrod String
    activeStatus ActiveStatus @default(ACTIVE)
    role Role @default(USER)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    profileId Profile?
    
    @@map("users")
}

